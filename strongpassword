def StrongPassword(pas):
    c_count=0
    d_count=0
    cap_count=0
    low_count=0
    flag=0
    for i in pas:
        if i.isalpha():
            c_count+=1
        if i.isdigit():
            d_count+=1
        if i.isupper():
            cap_count+=1
        if i.islower():
            low_count+=1
        if (i+i+i) in pas:
            print("Repeating characters(x3) Present")
            exit()
    if c_count+d_count<6:
        print(f"Requires atleast {6-(c_count+d_count)} charaters")
        flag=-1
    if c_count+d_count>20:
        print(f"Remove atmost {(c_count+d_count)-20} characters")
        flag=-1
    if d_count<1:
        print("Requires atleast one digit")
        flag=-1
    if cap_count<1:
        print("Requires atleast a Uppercase Letter")
        flag=-1
    if low_count<1:
        print("Requires atleast a lowercase Letter ")
        flag=-1
    if flag<0:
        return -1
    else:
        return 1
    
pas=input().strip()
if StrongPassword(pas)==1:
    print("Strong Password")



